# RCS-AC-v2 local/generated artifacts.
# Keep source, docs, configs, scripts, tests, and small result summaries in git.

# Python/cache noise
__pycache__/
*.py[cod]
.pytest_cache/

# Local virtual environments inside this subtree
.venv/
venv/
env/

# The package has a source directory named env; keep it trackable despite
